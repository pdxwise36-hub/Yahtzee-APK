<?xml version="1.0" encoding="utf-8"?>
<!-- The pale gradient behind the die, matching the icon's own background.
     A shape rather than a bitmap so it stays clean at every launcher size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F2F5F9"
        android:endColor="#B9C6D6"
        android:type="linear" />
</shape>
